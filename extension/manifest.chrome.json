{
  "manifest_version": 3,
  "name": "maki",
  "description": "Logins and codes from maki, approved on maki's own screen.",
  "version": "0.1.0",
  "key": "",
  "permissions": ["nativeMessaging"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"], "js": ["content.js"], "all_frames": true, "run_at": "document_idle" }
  ],
  "action": { "default_title": "maki", "default_popup": "popup.html", "default_icon": "icon.png" },
  "icons": { "128": "icon.png" }
}
