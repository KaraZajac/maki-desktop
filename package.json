{
  "name": "maki-desktop",
  "version": "0.1.0",
  "description": "Desktop companion for maki: links it over USB, keeps its clock verified and its backups, and brings it apps from the maki store",
  "main": "./out/main/index.js",
  "author": ".leviathan.",
  "license": "BSD-3-Clause",
  "private": true,
  "desktopName": "maki.desktop",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:extension": "node extension/build.mjs",
    "dist": "electron-vite build && electron-builder",
    "dist:linux": "npm run build:sudo && electron-vite build && electron-builder --linux",
    "build:sudo": "cargo build --release --manifest-path sudo/Cargo.toml",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck:ext": "tsc --noEmit -p extension/tsconfig.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:ext",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest run"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/chrome": "^0.3.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/w3c-web-serial": "^1.0.7",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.25.12",
    "happy-dom": "^20.14.5",
    "litesvm": "^1.5.0",
    "prettier": "^3.4.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.21.5": true
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@paulmillr/qr": "^0.3.0",
    "@scure/base": "^2.4.0",
    "@scure/bip32": "^2.4.0",
    "@scure/btc-signer": "^2.4.1"
  }
}
